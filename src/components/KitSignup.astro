---
/**
 * Kit (ConvertKit) inline email signup.
 *
 * Kit's embed script finds every `script[data-uid]` on the page and replaces
 * each one with a form, then loads `f.convertkit.com/ckjs/ck.*.js` once.
 * The footer instance loads the script (`loadScript` default). Other
 * instances pass `loadScript={false}` so they only emit a marker and the
 * footer script hydrates them without fetching index.js twice.
 */
interface Props {
	loadScript?: boolean;
}

const { loadScript = true } = Astro.props;
---

<div class="kit-signup">
	{
		loadScript ? (
			<script
				is:inline
				async
				data-uid="62bd20fc13"
				src="https://simple-survival-mode.kit.com/62bd20fc13/index.js"
			></script>
		) : (
			<script is:inline data-uid="62bd20fc13"></script>
		)
	}
	<noscript>
		<p class="kit-signup-fallback">
			<a href="https://simple-survival-mode.kit.com/62bd20fc13"
				>Get new posts by email</a
			>
		</p>
	</noscript>
</div>

<style>
	.kit-signup {
		width: 100%;
		max-width: 42rem;
	}

	.kit-signup :global(.formkit-form) {
		max-width: 100%;
	}

	.kit-signup-fallback {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.kit-signup-fallback a {
		color: var(--color-text-secondary);
		text-decoration: underline;
	}

	.kit-signup-fallback a:hover {
		color: var(--color-text);
	}
</style>
